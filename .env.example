# Copy to .env and fill in. .env is gitignored.

# AWS
# Use the Databricks workspace's region (SELECT current_metastore() shows aws:<region>:...)
AWS_REGION=us-east-2
AWS_PROFILE=default
LAKE_BUCKET=credit-risk-lakehouse-<your-suffix>
GLUE_JOB_NAME=credit_risk_bronze_to_silver
GLUE_ROLE_ARN=arn:aws:iam::<account-id>:role/credit-risk-glue-job

# Databricks Free Edition
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
DATABRICKS_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_CATALOG=credit_risk
DATABRICKS_JOB_NAME=credit_risk_dbt

# How Databricks reaches Glue's silver output.
#   external_location : Unity Catalog external location on s3://<bucket>/silver
#   volume            : Airflow copies silver Parquet into a UC Volume first
SILVER_ACCESS_MODE=volume

# Replayer
REPLAY_START_DATE=2026-10-01
REPLAY_CLIENTS_PER_SLICE=2000
