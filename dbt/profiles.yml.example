# Local dbt runs against Databricks Free Edition. Copy to ~/.dbt/profiles.yml (or to
# dbt/profiles.yml, which is gitignored) and export the variables from .env.
#
# The Databricks job does not use this file: the dbt task generates its own profile
# from the job's warehouse_id, catalog and schema.
credit_risk:
  target: dev
  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') | replace('https://', '') }}"
      http_path: "{{ env_var('DATABRICKS_WAREHOUSE_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'credit_risk') }}"
      schema: gold
      threads: 4
